From 26b37fe9903671d5090783b6c34b0ca05fb82317 Mon Sep 17 00:00:00 2001
From: Bo Gan <ganboing@gmail.com>
Date: Mon, 10 Nov 2025 19:14:07 -0800
Subject: [PATCH 2/4] riscv: dts: eic770x: Fix issues running upstream OpenSBI

Upstream-Status: Pending

---
 arch/riscv/dts/eic770x.dtsi | 19 +++++++++++++++++--
 1 file changed, 17 insertions(+), 2 deletions(-)

diff --git a/arch/riscv/dts/eic770x.dtsi b/arch/riscv/dts/eic770x.dtsi
index 5d9741e091..875805064f 100644
--- a/arch/riscv/dts/eic770x.dtsi
+++ b/arch/riscv/dts/eic770x.dtsi
@@ -33,6 +33,7 @@
 	cpus {
 		#address-cells = <1>;
 		#size-cells = <0>;
+		timebase-frequency = <1000000>;
 		cpu0: cpu@0 {
 			clock-frequency = <0>;
 			compatible = "eic7700", "riscv";
@@ -464,6 +465,16 @@
 			};
 		#endif
 		};
+		clint: timer@2000000 {
+			compatible = "eswin,eic7700-clint", "sifive,clint0";
+			reg = <0x0 0x02000000 0x0 0x10000>;
+			interrupts-extended =
+				<&cpu0_intc 3>, <&cpu0_intc 7>,
+				<&cpu1_intc 3>, <&cpu1_intc 7>,
+				<&cpu2_intc 3>, <&cpu2_intc 7>,
+				<&cpu3_intc 3>, <&cpu3_intc 7>;
+		};
+
 		plic0: interrupt-controller@c000000 {
 			status = "disabled";
 			#interrupt-cells = <1>;
@@ -563,15 +574,19 @@
 		};
 		uart0: serial@50900000 {
 			status = "disabled";
-			compatible = "synopsys,uart0";
+			compatible = "snps,dw-apb-uart";
 			clock-frequency = <200000000>;
+			reg-io-width = <4>;
+			reg-shift = <2>;
 			reg = <0x0 0x50900000 0x0 0xffff>;
 			reg-names = "control";
 		};
 		uart1: serial@50910000 {
 			status = "disabled";
-			compatible = "synopsys,uart0";
+			compatible = "snps,dw-apb-uart";
 			clock-frequency = <200000000>;
+			reg-io-width = <4>;
+			reg-shift = <2>;
 			reg = <0x0 0x50910000 0x0 0xffff>;
 			reg-names = "control";
 		};
-- 
2.34.1

